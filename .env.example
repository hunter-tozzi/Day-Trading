# Copy to .env and fill in your PAPER keys from https://app.alpaca.markets (Paper Trading > API Keys)
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here
# Must stay "true" unless you have deliberately decided to trade real money.
ALPACA_PAPER=true
# "iex" is free. "sip" needs a paid Alpaca data subscription.
ALPACA_DATA_FEED=iex
